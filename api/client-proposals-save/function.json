{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["post"],
      "route": "client-proposals/{id}"
    },
    {
      "type": "blob",
      "direction": "out",
      "name": "proposalBlob",
      "path": "client-proposals/{id}.json",
      "connection": "AzureWebJobsStorage"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    }
  ]
}
